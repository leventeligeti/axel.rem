# Copy to .env and fill in your values

# PostgreSQL (pgvector required)
REM_DB_HOST=localhost
REM_DB_PORT=5432
REM_DB_NAME=rem
REM_DB_USER=rem
REM_DB_PASS=

# Redis
REM_REDIS_HOST=localhost
REM_REDIS_PORT=6379
REM_REDIS_PASS=

# LLM — any OpenAI-compatible endpoint (Ollama, LiteLLM, OpenAI, Groq, ...)
REM_LLM_URL=http://localhost:11434
REM_LLM_API_KEY=
REM_LLM_MODEL=llama3.1

# Dream cycle — nightly consolidation hour (UTC, 0-23)
REM_DREAM_HOUR=3

# Agents tracked by the dream cycle (comma-separated)
REM_AGENTS=AXEL,FORGE
